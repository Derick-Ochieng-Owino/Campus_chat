rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to fetch user data cleanly
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // --- 1. University Data ---
    match /university_students/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // --- 2. Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // --- 3. Chats Collection ---
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        chatId in ['general_system_chat', 'year_3_sem_1_chat'] ||
        resource == null || 
        resource.data.type == 'general' || 
        request.auth.uid in resource.data.participants
      );
      
      allow create: if isAuthenticated() && (
        chatId in ['general_system_chat', 'year_3_sem_1_chat'] ||
        request.auth.uid in request.resource.data.participants
      );

      allow update: if isAuthenticated() && (
        chatId in ['general_system_chat', 'year_3_sem_1_chat'] ||
        request.auth.uid in resource.data.participants ||
        resource.data.type == 'general'
      );
    }

    // --- 4. Messages Sub-collection ---
    match /chats/{chatId}/messages/{messageId} {
      allow read: if isAuthenticated() && (
        chatId in ['general_system_chat', 'year_3_sem_1_chat'] ||
        get(/databases/$(database)/documents/chats/$(chatId)).data.type == 'general' ||
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
      );
      
      allow write: if isAuthenticated() && 
                   request.auth.uid == request.resource.data.senderId;
    }
    
    // --- 5. Course Units ---
    match /courseUnits/{unitId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }
    
    // --- 6. Deeply Hierarchical Group Sub-collections ---
    // Matches path: /groups/{campus}/{college}/{school}/{dept}/{course}/{year}/{sem}/{unitCode}/{groupId}
    match /groups/{campus}/{college}/{school}/{department}/{course}/{year}/{sem}/{unitCode}/{groupId} {
      
      // Standard reads are allowed for any registered student
      allow read: if isAuthenticated();

      // Creation & deletion restricted strictly to authorized administrative staff
      allow create, delete: if isAuthenticated() && 
                            getUserData().role in ['admin', 'class_rep', 'assistant', 'lecturer'];

      // Allows transactions to write mutations specifically targeting structural changes inside the 'members' key
      allow update: if isAuthenticated() && (
        getUserData().role in ['admin', 'class_rep', 'assistant', 'lecturer'] ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
      );
    }
    
    // Legacy single root-level flat groups group queries compatibility hook
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        request.auth.uid == resource.data.createdBy || 
        getUserData().role in ['admin', 'class_rep']
      );
    }
    
    // --- 7. Announcements (Collection Group Queries Clearance Match) ---
    match /{path=**}/notices/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && 
                            getUserData().role in ['admin', 'lecturer', 'class_rep', 'assistant'];
      allow delete: if isAuthenticated() && getUserData().role == 'admin';
    }
    
    // --- 8. Units, Notes, and Papers ---
    match /units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                    getUserData().role in ['admin', 'lecturer'];
    }
    
    match /units/{unitId}/notes/{noteId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                    getUserData().role in ['admin', 'lecturer', 'class_rep', 'assistant'];
    }
    
    match /units/{unitId}/papers/{paperId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                    getUserData().role in ['admin', 'lecturer', 'class_rep', 'assistant'];
    }
    
    // --- 9. Statuses / Ads ---
    match /statuses/{statusId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && getUserData().role == 'admin';
    }
    
    match /statuses/{statusId}/viewers/{viewerId} {
      allow create: if isAuthenticated() && request.auth.uid == viewerId;
      allow read: if isAuthenticated() && getUserData().role == 'admin';
    }
    
    match /statuses/{statusId}/viewers/count {
      allow read, create, update: if isAuthenticated();
    }
  }
}